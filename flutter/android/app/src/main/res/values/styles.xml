<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Before Android 12 the phone cannot be told which theme the app is set to, so here
         the launch screen is the dark one, which is how the app opens unless the user chose
         otherwise. From Android 12 see values-v31 and values-night-v31. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_bg</item>
    </style>
</resources>
